{
  // Mirrors identigon/identigon's own .markdownlint-cli2.jsonc. "default" stated explicitly
  // rather than left implicit. MD013's line_length MUST match this repo's own .prettierrc.json
  // printWidth (100) - change one, change both. Tables and code blocks exempt (no sensible way to
  // "wrap" either without corrupting them); headings exempt (one line by construction). `stern`
  // catches an ordinary prose line with one long trailing word, without flagging a line that is
  // purely one unbreakable token (a bare URL on its own line).
  //
  // MD024 (no-duplicate-heading) uses `siblings_only` for parity with the sibling repo - this
  // repo has no CHANGELOG.md of its own to trigger the case that setting exists for.
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false,
      "headings": false,
      "stern": true
    },
    "MD024": {
      "siblings_only": true
    },
    // VitePress's own heading-anchor slugifier prefixes a heading that starts with a digit with
    // `_` ("## 4. Validate the policy" -> id="_4-validate-the-policy"), not the GitHub-style slug
    // MD051 assumes. A same-page anchor link to a numbered heading (getting-started.md has
    // several) would always look "invalid" to this rule even when correct for the real site -
    // verify those by building the site and checking the actual generated id instead.
    "MD051": false
  }
}
